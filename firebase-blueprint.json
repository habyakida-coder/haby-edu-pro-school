{
  "collections": [
    {
      "name": "schools",
      "description": "Registered schools using the system",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "createdAt", "type": "timestamp" },
        { "name": "status", "type": "string", "description": "ACTIVE, INACTIVE, or DORMANT" },
        { "name": "adminUid", "type": "string" }
      ]
    },
    {
      "name": "users",
      "description": "User profiles with roles and school association",
      "fields": [
        { "name": "email", "type": "string" },
        { "name": "role", "type": "string", "description": "HEADMASTER, ACADEMIC, or TEACHER" },
        { "name": "schoolId", "type": "string" },
        { "name": "fullName", "type": "string" },
        { "name": "isSuperAdmin", "type": "boolean" }
      ]
    },
    {
      "name": "schoolData",
      "description": "Consolidated timetable and school-specific configuration",
      "fields": [
        { "name": "schoolId", "type": "string" },
        { "name": "teachers", "type": "array" },
        { "name": "assignments", "type": "array" },
        { "name": "periodSettings", "type": "array" },
        { "name": "streamSettings", "type": "array" },
        { "name": "invigilationAssignments", "type": "map" },
        { "name": "exams", "type": "array" },
        { "name": "activityLogs", "type": "array", "description": "Audit trail entries tracking timetable, teacher, and student edits" },
        { "name": "examinationRecords", "type": "array", "description": "Academic examination records across terms and years" },
        { "name": "promotionHistory", "type": "array", "description": "Student promotion and graduation logs" },
        { "name": "transferHistory", "type": "array", "description": "Student stream and class transfer logs" },
        { "name": "institutionalPolicy", "type": "map", "description": "Institutional timetable policies, breaks, and limits" },
        { "name": "subjectPeriodAllocations", "type": "array", "description": "Subject period allocations per level" },
        { "name": "teacherAssignments", "type": "array", "description": "Teacher level, subject and stream assignments" }
      ]
    }
  ]
}
